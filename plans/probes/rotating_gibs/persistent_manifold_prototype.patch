+// How far apart two kept points must be to count as different contacts.
+template <typename T> static T probe_merge_radius() { return scalar_traits<T>::from_milli(60); }
+// How far a kept point may drift off the live contact plane before it is dropped.
+template <typename T> static T probe_break_tol() { return scalar_traits<T>::from_milli(20); }
 
+// Which kept point a fresh witness IS. Nearest one within the merge radius; failing
+// that, nearest of all four once the partner's budget is spent (a manifold has a
+// FIXED width — letting a turning body keep adding points is how it ends up held at
+// a dozen places at once and thrown across the map). Null means "a new point".
 template <typename T>
+typename solid<T>::touch * simulator<T>::probe_pick_slot(solid<T> * s, const solid<T> * partner, const vec3<T> & lever) {
+	typename solid<T>::touch * nearest = nullptr;
+	T best {};
+	int n = 0;
+	for (int i = 0; i < s->touch_count_; ++i) {
+		auto & o = s->touches_[i];
+		if (o.partner != partner) continue;
+		++n;
+		vec3<T> d;
+		sub(d, o.lever, lever);
+		const T dist = length(d);
+		if (!nearest || dist < best) { nearest = &o; best = dist; }
+	}
+	if (!nearest) return nullptr;
+	if (best <= probe_merge_radius<T>()) return nearest;
+	return (n >= 4) ? nearest : nullptr;
+}
