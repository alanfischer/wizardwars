+// tick alongside the fresh one; one that has lifted off is dropped. This is what
+// turns a witness that alternates end to end into a manifold that holds both ends.
+template <typename T>
+void simulator<T>::probe_revive_manifold(int tick) {
+	const T tol = probe_break_tol<T>();
+	for (auto & sp : solids_) {
+		solid<T> * s = sp.get();
+		if (!s->active_) continue;
+		for (int i = 0; i < s->touch_count_; ++i) {
