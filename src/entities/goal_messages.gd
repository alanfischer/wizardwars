static func translate(text: String) -> String:
	text = text.replace("\\n", "\n")
	if text.begins_with("#") and TOKENS.has(text):
		return TOKENS[text]
	if text.begins_with("#"):
		var clean := text.substr(1)
		var parts := clean.split("_")
		if parts.size() >= 3 and (parts[0] == "ww" or parts[0] == "2fort"):
			clean = "_".join(parts.slice(2))
		elif parts.size() >= 2 and parts[0] in ["ctf", "cz", "warpath", "dustbowl"]:
			clean = "_".join(parts.slice(1))
		text = clean.replace("_", " ").capitalize()
	return text.replace("Flag", "Grail").replace("flag", "grail")
