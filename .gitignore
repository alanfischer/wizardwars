# Run artifacts: the game writes client.log itself (Log.enable_file_logging), and
# sample.txt is a macOS `sample` profiler dump — both regenerate, neither belongs in git.
*.log
/sample.txt

# Stamped into the .pck by build.sh; regenerated on every build.
/build_id.txt

# Editor leftovers. A b0VIM swap for TODO.txt rode into e8c6ddae because nothing
# here stopped it.
*.swp
*.swo

# Where release.sh ships to (WW_SERVER_HOST, WW_REMOTE, WW_SSH_PORT), and the host build.sh
# stamps from it. Kept out of git so the public source never names the server.
/release.env
/default_server.txt
