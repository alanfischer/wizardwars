; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Wizard Wars"
config/version="1.0.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://logo.png"

[audio]

driver/enable_input=true

[autoload]

Log="*res://src/systems/log.gd"
EntityRender="*res://src/systems/entity_render.gd"
GoldSrcEntity="*res://src/systems/goldsrc_entity.gd"
BoneUtil="*res://src/systems/bone_util.gd"
Teams="*res://src/systems/teams.gd"
SpatialQuery="*res://src/systems/spatial_query.gd"
Combat="*res://src/systems/combat.gd"
Game="*res://src/systems/game.gd"
AssetLoader="*res://src/systems/asset_loader.gd"
TriggerSystem="*res://src/systems/trigger_system.gd"
GoalSystem="*res://src/systems/goal_system.gd"
SpawnSystem="*res://src/systems/spawn_system.gd"
NetworkManager="*res://src/systems/network_manager.gd"
ServerBrowser="*res://src/systems/server_browser.gd"
MapTransfer="*res://src/systems/map_transfer.gd"
LagCompensation="*res://src/systems/lag_compensation.gd"
ServerVars="*res://src/systems/server_vars.gd"
MatchSystem="*res://src/systems/match_system.gd"
CommandSystem="*res://src/systems/command_system.gd"
SpawnRegistry="*res://src/systems/spawn_registry.gd"
ClientCommandSystem="*res://src/systems/client_command_system.gd"
SoundSystem="*res://src/systems/sound_system.gd"
SentenceSystem="*res://src/systems/sentence_system.gd"
BeamSystem="*res://src/systems/beam_system.gd"
StatusSystem="*res://src/systems/status_system.gd"
VisibilitySystem="*res://src/systems/visibility_system.gd"
BotSystem="*res://src/bot/bot_system.gd"
SiegeSystem="*res://src/systems/siege_system.gd"
VoiceChat="*res://src/systems/voice_chat.gd"
XRManager="*res://src/xr_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/godotopenxrvendors/plugin.cfg", "res://addons/goldsrc/plugin.cfg")

[importer_defaults]

goldsrc.bsp={
"fallback_wads": "res://ww_base.wad"
}

