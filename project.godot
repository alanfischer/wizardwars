[layer_names]

3d_physics/layer_1="default"
3d_physics/layer_2="ladder"
3d_physics/layer_3="water"
3d_physics/layer_13="lava"
3d_physics/layer_14="slime"

[physics]

3d/physics_engine="Hop Physics"
3d/default_gravity=20.0
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.pc="gl_compatibility"

[xr]

openxr/extensions/hand_tracking=true
shaders/enabled=true
openxr/enabled.android=true
openxr/extensions/meta/passthrough=true
